# ==============================================================================
# CẤU HÌNH KẾT NỐI BLOCKCHAIN CHO ADMIN BACKEND
# Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
# File ".env" không nên commit lên git (đã thêm vào .gitignore).
# ==============================================================================

# Địa chỉ RPC của mạng blockchain.
# - Ganache GUI (mặc định):        http://127.0.0.1:7545
# - Ganache CLI (mặc định):        http://127.0.0.1:8545
# - Sepolia Testnet (qua Infura):  https://sepolia.infura.io/v3/<API_KEY>
RPC_URL=http://127.0.0.1:7545

# Địa chỉ hợp đồng Election.sol đã deploy (copy từ Ganache/Remix/Truffle sau khi deploy)
CONTRACT_ADDRESS=0xYourDeployedContractAddressHere

# Đường dẫn tới file ABI (mặc định đã đúng, thường không cần đổi)
ABI_PATH=ElectionABI.json

# ------------------------------------------------------------------------------
# TÀI KHOẢN ADMIN (phải TRÙNG với địa chỉ đã deploy hợp đồng, vì modifier
# onlyAdmin trong Election.sol chỉ cho phép msg.sender == admin)
# ------------------------------------------------------------------------------
# CÁCH 1 (khuyên dùng khi chạy với Ganache): để trống ADMIN_PRIVATE_KEY,
# chỉ định chỉ số tài khoản Ganache (mặc định 0 = tài khoản đầu tiên, thường
# cũng chính là tài khoản deploy contract). Ganache sẽ tự ký giao dịch giúp.
ADMIN_ACCOUNT_INDEX=0

# CÁCH 2 (bắt buộc khi chạy với Sepolia hoặc mạng thật): điền private key của
# tài khoản Admin. Khi để giá trị này, nó sẽ được ưu tiên dùng thay cho CÁCH 1.
# KHÔNG BAO GIỜ commit private key thật lên git hoặc chia sẻ công khai.
ADMIN_PRIVATE_KEY=

# ==============================================================================
# CẤU HÌNH MYSQL (lưu dữ liệu off-chain: mã SBD, đơn vị, mô tả/thời gian phiên)
# App sẽ tự tạo database và các bảng cần thiết nếu chưa tồn tại (xem
# storage.init_db()), bạn chỉ cần đảm bảo MySQL server đang chạy và tài
# khoản DB_USER có quyền tạo database.
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=election_admin

# ==============================================================================
# CẤU HÌNH FRONTEND (React + Vite, chạy bằng "npm run dev")
# Vite chỉ đưa các biến có tiền tố VITE_ vào code chạy trong trình duyệt.
# Frontend giờ KHÔNG còn nói chuyện trực tiếp với blockchain nữa (không còn
# MetaMask) — chỉ gọi vào voter_api.py bằng fetch(), nên chỉ cần đúng 1 biến
# là địa chỉ của server đó. Dùng chung 1 file .env cho cả adminUI.py,
# voter_api.py lẫn frontend là bình thường, mỗi bên chỉ đọc đúng phần biến
# nó cần.
# ==============================================================================
VITE_API_BASE_URL=http://127.0.0.1:8001

# ==============================================================================
# CẤU HÌNH VÍ CỬ TRI DO HỆ THỐNG GIỮ HỘ (custodial wallet) — voter_accounts.py
# ==============================================================================

# Khóa mã hóa private key của cử tri trước khi lưu MySQL (thuật toán Fernet).
# Sinh 1 lần bằng lệnh:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# dán kết quả vào đây. TUYỆT ĐỐI không đổi lại sau khi đã có cử tri trong hệ
# thống — đổi khóa này sẽ khiến mọi private key đã mã hóa trước đó hỏng vĩnh
# viễn (không giải mã lại được, không bầu được nữa).
VOTER_KEY_ENCRYPTION_KEY=jxkbWqvb4gl6QEvx7KRbnCImMAmH-uNoEEGWAoobvUI=

# Chuỗi bí mật cộng thêm khi băm CCCD (tăng an toàn chống dò ngược bằng
# rainbow table). Đặt một chuỗi bất kỳ, giữ bí mật, không cần nhớ/gõ lại.
CCCD_HASH_PEPPER=doi-chuoi-nay-thanh-bi-mat-cua-ban

# Số ETH bơm cho mỗi ví cử tri mới (đủ trả gas cho đúng 1 giao dịch vote()).
VOTER_FUNDING_AMOUNT_ETH=0.01
